# Restart the service, so bin/discover-ldap refreshes the LDAP settings

import json
import os
import sys
import agent

event = json.load(sys.stdin)

if event.get('domain') != os.getenv('LDAP_DOMAIN'):
    sys.exit(0)

if 'node' in event and str(event['node']) != os.getenv('NODE_ID'):
    sys.exit(0)  # ignore event if the source is not in our node

agent.run_helper('systemctl', '--user', '-T', 'try-restart', 'visitors.service').check_returncode()

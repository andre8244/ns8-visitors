#
# Find settings for the LDAP service, through the node Ldapproxy
#

import os
import agent
from agent.ldapproxy import Ldapproxy

try:
    odom = Ldapproxy().get_domain(os.environ.get('LDAP_DOMAIN', ''))
    'host' in odom  # Throw exception if odom is None
except Exception:
    # During restore the domain could be unavailable. Use a fallback
    # configuration, pointing to nowhere, just to set the variables.
    # Once the domain becomes available, the event will fix them.
    odom = {
        'host': '127.0.0.1',
        'port': 20000,
        'schema': 'rfc2307',
        'base_dn': 'dc=visitors,dc=invalid',
        'bind_dn': 'cn=example,dc=visitors,dc=invalid',
        'bind_password': 'invalid',
    }

with agent.safe_open("discovery_ldap.env", "w") as denv:
    print(f"NUXT_LDAP_HOST={odom['host']}", file=denv)
    print(f"NUXT_LDAP_PORT={odom['port']}", file=denv)
    print(f"NUXT_LDAP_SCHEMA={odom['schema']}", file=denv)
    print(f"NUXT_LDAP_BASE_DN={odom['base_dn']}", file=denv)
    print(f"NUXT_LDAP_BIND_DN={odom['bind_dn']}", file=denv)
    print(f"NUXT_LDAP_BIND_PASSWORD={odom['bind_password']}", file=denv)

# Generate the secret that seals the web application session cookies.
# The file is included in the backup, so sessions survive a restore.

import os
import secrets
import agent

passwords = {
    "NUXT_SESSION_PASSWORD": secrets.token_urlsafe(48),
}
agent.write_envfile("passwords.env", passwords)
os.chmod("passwords.env", 0o600)

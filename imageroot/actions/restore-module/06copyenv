import json
import sys
import agent

request = json.load(sys.stdin)
original_environment = request['environment']

for evar in [
        "LDAP_DOMAIN",
        "ADMIN_GROUP",
        "TRAEFIK_HOST",
        "TRAEFIK_HTTP2HTTPS",
        "TRAEFIK_LETS_ENCRYPT",
        "IP_ALLOWLIST",
    ]:
    agent.set_env(evar, original_environment.get(evar, ""))

# Call configure-module with all the variables restored by 06copyenv

import os
import sys
import agent
import agent.tasks

ip_allowlist = os.environ.get("IP_ALLOWLIST", "")

response = agent.tasks.run("module/" + os.environ["MODULE_ID"], action="configure-module", data={
    "host": os.environ["TRAEFIK_HOST"],
    "http2https": os.environ.get("TRAEFIK_HTTP2HTTPS") == "True",
    "lets_encrypt": os.environ.get("TRAEFIK_LETS_ENCRYPT") == "True",
    "ldap_domain": os.environ["LDAP_DOMAIN"],
    "admin_group": os.environ["ADMIN_GROUP"],
    "ip_allowlist": ip_allowlist.split(",") if ip_allowlist else [],
})

agent.assert_exp(response['exit_code'] == 0)

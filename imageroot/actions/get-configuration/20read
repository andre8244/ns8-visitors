import json
import os
import sys
from agent.ldapproxy import Ldapproxy

ip_allowlist = os.getenv("IP_ALLOWLIST", "")

config = {
    "host": os.getenv("TRAEFIK_HOST", ""),
    "http2https": os.getenv("TRAEFIK_HTTP2HTTPS", "True") == "True",
    "lets_encrypt": os.getenv("TRAEFIK_LETS_ENCRYPT", "False") == "True",
    "ldap_domain": os.getenv("LDAP_DOMAIN", ""),
    "ldap_domain_list": sorted(Ldapproxy().get_domains_list()),
    "admin_group": os.getenv("ADMIN_GROUP", "visitors-admin"),
    "ip_allowlist": ip_allowlist.split(",") if ip_allowlist else [],
}

json.dump(config, fp=sys.stdout)

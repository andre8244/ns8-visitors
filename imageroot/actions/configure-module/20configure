import json
import os
import sys
import agent
from agent.ldapproxy import Ldapproxy

request = json.load(sys.stdin)

# A new user domain must exist: the admins sign in with its accounts.
# The current one is not checked: during a restore it can still be missing
changed = request["ldap_domain"] != os.getenv("LDAP_DOMAIN")
if changed and request["ldap_domain"] not in Ldapproxy().get_domains_list():
    agent.set_status('validation-failed')
    json.dump([{'field': 'ldap_domain', 'parameter': 'ldap_domain', 'value': request["ldap_domain"], 'error': 'ldap_domain_not_found'}], fp=sys.stdout)
    sys.exit(3)

# Bind the module to the user domain, to read its LDAP settings
agent.bind_user_domains([request["ldap_domain"]])

agent.set_env("LDAP_DOMAIN", request["ldap_domain"])
agent.set_env("ADMIN_GROUP", request["admin_group"])
agent.set_env("TRAEFIK_HOST", request["host"])
agent.set_env("TRAEFIK_HTTP2HTTPS", request.get("http2https", True))
agent.set_env("TRAEFIK_LETS_ENCRYPT", request.get("lets_encrypt", False))
agent.set_env("IP_ALLOWLIST", ",".join(request.get("ip_allowlist", [])))

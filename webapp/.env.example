# Local development settings: copy to .env and adjust. The LDAP values
# match the test server started by `pnpm dev:ldap`
NUXT_SESSION_PASSWORD=change-me-with-at-least-32-random-characters
NUXT_ADMIN_GROUP=visitors-admin
NUXT_LDAP_HOST=127.0.0.1
NUXT_LDAP_PORT=3890
NUXT_LDAP_BIND_DN=cn=admin,dc=visitors,dc=test
NUXT_LDAP_BIND_PASSWORD=admin
NUXT_LDAP_BASE_DN=dc=visitors,dc=test
NUXT_LDAP_SCHEMA=rfc2307
